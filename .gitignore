.venv/
venv/
__pycache__/
*.py[cod]
*$py.class

# مخرجات الاختبارات
/tests/_out/

# مخرجات بناء نسخة exe (PyInstaller) والمُثبِّت (Inno Setup)
/build/
/dist/
/Output/

# أدوات المساعد الداخلية
.claude/

# ملفات مؤقتة/محرّرات
*.tmp
*.log
.vscode/
.idea/
Thumbs.db
desktop.ini

# محرّك OCR المضمّن (كبير - لا يُرفع)
